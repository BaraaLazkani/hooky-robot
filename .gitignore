# checkpoints are already tracked, and ignore rules don't affect tracked files.
runs/**/weights/epoch*.pt

# --- Editor / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Personal documents. Never commit these. ---
photo_*.jpg
photo_*.JPG
