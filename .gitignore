# --- ROS 2 / colcon build output ---
build/
install/
log/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
camenv/
.venv/
venv/

# --- Archives and recordings (large, redundant copies of tracked files) ---
*.zip
*.mkv
*.mp4

# --- Ultralytics / training caches (regenerated on demand) ---
*.cache
